{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    // Deliberately NOT enabling noUnusedLocals/noUnusedParameters: this repo is a
    // scratchpad for talk visuals, and half-finished experiments should not error.
    "paths": {
      "@": ["./src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "demos/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist", "out"]
}
